{
  "name": "luxvm-desktop",
  "version": "1.5.1",
  "description": "LuxVM — a multi-modal AI workstation powered by OpenRouter",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.electron.json && vite build && electron-builder --publish never",
    "build:web": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "build:release": "npm run typecheck && tsc -p tsconfig.electron.json && vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "mathjs": "^15.2.0",
    "stockfish": "^19.0.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.luxvm.desktop",
    "productName": "LuxVM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "third_party/stockfish/Copying.txt",
        "to": "licenses/stockfish-Copying.txt"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RiceCrackerLOL",
        "repo": "luxvm-releases",
        "releaseType": "release"
      }
    ]
  }
}
